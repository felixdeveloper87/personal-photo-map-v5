# ===========================================
# PhotoMap Production Environment
# ===========================================
# IMPORTANT: Update these values for production!

# Database Configuration
DB_NAME=photomap_prod
DB_USER=photomap_user
DB_PASSWORD=your_secure_database_password_here

# Backend Configuration
APP_BASE_URL=https://api.personalphotomap.co.uk
BACKEND_URL=https://api.personalphotomap.co.uk
UPLOAD_DIR=/photomap/storage/uploads

# JWT Configuration (IMPORTANT: Generate a secure secret!)
# Use: openssl rand -base64 64
JWT_SECRET=your_secure_jwt_secret_here

# Frontend Configuration
VITE_BACKEND_URL=https://api.personalphotomap.co.uk

# Cloudinary Configuration (external image processing)
CLOUDINARY_ENABLED=true
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenAI API Configuration (for generating country curiosities)
OPENAI_API_KEY=your_openai_api_key_here





