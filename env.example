# ===========================================
# PhotoMap Environment Variables
# ===========================================
# Copy this file to .env and update the values

# Database Configuration
# ======================
DB_NAME=photomap
DB_USER=photomap
DB_PASSWORD=photomap123

# Backend Configuration
# =====================
APP_BASE_URL=http://localhost:8092
BACKEND_URL=http://localhost:8092

# JWT Configuration
# =================
# IMPORTANT: Generate a secure secret for production!
# Use: openssl rand -base64 64
JWT_SECRET=mySecretKey123456789012345678901234567890123456789012345678901234567890

# Frontend Configuration
# ======================
VITE_BACKEND_URL=http://localhost:8092

# Production Only (uncomment for production)
# ==========================================
# APP_BASE_URL=https://api.personalphotomap.co.uk
# BACKEND_URL=https://api.personalphotomap.co.uk
# VITE_BACKEND_URL=https://api.personalphotomap.co.uk




